  <diagram name="C4 Context — Умный дом" id="C4_Context_—_Умный_дом">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object placeholders="1" c4Name="Собственник / жилец" c4Type="Person" c4Description="Пользуется мобильным приложением: управляет доступом, отвечает на вызовы домофона, проходит в дом по лицу, въезжает по госномеру" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="p-owner"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="520" y="0" width="200" height="180" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="Гость / курьер" c4Type="Person" c4Description="Звонит в квартиру через домофон" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="p-guest"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="1180" y="0" width="200" height="180" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="Диспетчер УК / охрана" c4Type="Person" c4Description="Контролирует проход и въезд, обрабатывает обращения" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="p-uk"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="-160" y="620" width="200" height="180" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="PropDevelopment — сервисы ЖКУ" c4Type="Software System" c4Description="Мобильное приложение собственника, tenant-core-app, CRM собственников, новый smart-home-service и шлюз партнёрских интеграций. Источник истины о собственниках и их правах доступа" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="s-pd"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="440" y="380" width="360" height="160" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="Платформа «Умный дом» партнёра" c4Type="Software System" c4Description="Облачная платформа партнёра: управление устройствами, распознавание лиц и госномеров, медиасервер видеовызовов" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="s-partner"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1120" y="380" width="240" height="120" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="Интеллектуальный домофон" c4Type="Software System" c4Description="Устройство партнёра: видеовызов, открытие по звонку, распознавание лиц" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="s-intercom"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1500" y="140" width="240" height="120" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="Интеллектуальный шлагбаум" c4Type="Software System" c4Description="Устройство партнёра: камера распознавания госномеров, привод шлагбаума" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="s-barrier"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1500" y="640" width="240" height="120" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="Система управляющей компании" c4Type="Software System" c4Description="Существующий партнёр: данные о домах, лицевых счетах, жильцах" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="s-uk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="-160" y="380" width="240" height="120" as="geometry" /></mxCell></object>
        <object placeholders="1" c4Name="Сервисы push-уведомлений (APNs / FCM)" c4Type="Software System" c4Description="Доставка уведомлений о вызове домофона и событиях доступа" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#cccccc"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="s-push"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="440" y="760" width="240" height="120" as="geometry" /></mxCell></object>
        <mxCell id="e-1" value="Управляет доступом, открывает дверь/шлагбаум,&lt;br&gt;регистрирует лицо и госномера&lt;br&gt;[HTTPS, OIDC]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p-owner" target="s-pd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-2" value="Видеовызов домофона&lt;br&gt;[WebRTC/SRTP, одноразовый токен]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p-owner" target="s-partner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-3" value="Проходит в подъезд&lt;br&gt;(распознавание лица)" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p-owner" target="s-intercom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-4" value="Въезжает&lt;br&gt;(распознавание госномера)" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p-owner" target="s-barrier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-5" value="Звонит в квартиру" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p-guest" target="s-intercom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-6" value="Белые списки, команды открытия,&lt;br&gt;регистрация биометрии, журнал событий&lt;br&gt;[HTTPS REST, mTLS + OAuth 2.0]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s-pd" target="s-partner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-7" value="События: вызов, проход, въезд, тревога&lt;br&gt;[Webhooks HTTPS, mTLS + HMAC-подпись]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s-partner" target="s-pd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-8" value="Управление, прошивки, видео&lt;br&gt;[защищённый канал партнёра, VPN/mTLS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s-partner" target="s-intercom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-9" value="Управление, распознавание номеров&lt;br&gt;[защищённый канал партнёра, VPN/mTLS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s-partner" target="s-barrier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-10" value="Сверка жильцов и помещений&lt;br&gt;[REST, mTLS]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s-pd" target="s-uk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-11" value="Уведомления о вызове/событиях&lt;br&gt;[HTTPS] (без ПДн в payload)" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s-pd" target="s-push"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-12" value="Просмотр журнала доступа по своему ЖК&lt;br&gt;[HTTPS, SSO]" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p-uk" target="s-pd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-13" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;Синий — система в фокусе (PropDevelopment)&lt;br&gt;Серый — внешние системы и устройства партнёра&lt;br&gt;Тёмно-синий — пользователи" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-160" y="0" width="380" height="90" as="geometry" /></mxCell>
