<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Безопасность данных" id="Безопасность_данных">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="center" value="&lt;b&gt;Безопасность данных&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=18;fillColor=#1061B0;strokeColor=#0D5091;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="-110" y="-50" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="v-1" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="940" y="-1006" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-2" value="Цена и характеристики на витрине — фактически публичная оферта. Подмена или ошибка ведёт к спорам с покупателями (Закон о защите прав потребителей), претензиям ФАС за недостоверную рекламу и репутационному ущербу." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-1016" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-3" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-1" target="v-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-4" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="940" y="-890" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-5" value="Каталог публикуется через Kafka без контроля качества. Устаревший статус доступности приводит к бронированию уже проданных квартир, повторной работе менеджеров и жалобам." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-900" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-6" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-4" target="v-5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-7" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="940" y="-774" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-8" value="Каталог восстанавливается из client-mart-estate-db и резервных копий, которые делаются для всех БД. Простой витрины будет коротким и не затронет сделки." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-784" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-9" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-7" target="v-8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-10" value="Каталог объектов недвижимости на витрине: описания, планировки, цены, статус доступности (Витрина продаж, client-mart-estate-app)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="-910" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-11" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-10" target="v-1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-12" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-10" target="v-4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-13" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-10" target="v-7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-14" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="940" y="-658" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-15" value="Контент изначально создаётся для публичного показа. Если он утечёт до старта продаж, конкуренты получат лишь небольшое преимущество, а прямого ущерба клиентам не будет." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-668" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-16" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-14" target="v-15"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-17" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="940" y="-542" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-18" value="Исходники есть у подрядчика и в бэкапах. Пока тур восстанавливают, клиенты могут смотреть объект офлайн." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-552" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-19" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-17" target="v-18"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-20" value="Контент онлайн-тура: 3D-модели, фото, видео объектов (client-tour-app)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="-620" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-21" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-20" target="v-14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-22" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-20" target="v-17"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-23" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="940" y="-426" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-24" value="Данные приходят от партнёров (УК) без единых политик безопасности. Подменённое объявление, например с фишинговыми реквизитами оплаты, приведёт к финансовым потерям собственников и ударит по репутации." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-436" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-25" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-23" target="v-24"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-26" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="940" y="-310" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-27" value="Устаревшие новости снижают доверие к приложению, но прямого финансового или юридического ущерба не несут." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-320" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-28" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-26" target="v-27"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-29" value="Публичные объявления УК и новости ЖК: тарифы, контакты, отключения" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="-388" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-30" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-29" target="v-23"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-31" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-29" target="v-26"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-32" value="&lt;b&gt;Публичные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="300" y="-658" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="e-33" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="center" target="v-32"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-34" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-32" target="v-10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-35" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-32" target="v-20"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-36" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-32" target="v-29"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-37" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="940" y="-134" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-38" value="Нарушение 152-ФЗ грозит оборотными штрафами (ст. 13.11 КоАП) и уголовной ответственностью (ст. 272.1 УК РФ). ПДн копируются в DWH без ограничений доступа, а ещё попадают в контракты API." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-144" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-39" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-37" target="v-38"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-40" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="940" y="-18" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-41" value="Из-за нескольких несогласованных точек регистрации появляются дубли и расхождения. Ошибка в данных расширенной формы переносится в документы онлайн-сделки, и госорган может отказать в регистрации." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="-28" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-42" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-40" target="v-41"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-43" value="ПДн клиентов: ФИО, телефон, e-mail, расширенная форма — паспорт, СНИЛС, адрес (client-crm-app, crm-db, client-mart-db, auth-db-1, DWH)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="-96" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-44" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-43" target="v-37"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-45" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-43" target="v-40"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-46" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="940" y="98" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-47" value="В API партнёров нет изоляции: сотрудник одной УК видит данные клиентов другой. Связка «адрес + ФИО + лицевой счёт» — это нарушение 152-ФЗ и риск мошенничества." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="88" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-48" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-46" target="v-47"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-49" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="940" y="214" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-50" value="Через API партнёр может изменить данные чужих собственников. Это даёт неверные начисления ЖКУ и споры, но данные можно восстановить из бэкапов и первичных документов." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="204" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-51" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-49" target="v-50"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-52" value="ПДн собственников и данные помещений: ФИО, адрес, лицевой счёт, проживающие, показания счётчиков (CRM ЖКУ, crm-tenant-db, tenant-core-db, API УК)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="136" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-53" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-52" target="v-46"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-54" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-52" target="v-49"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-55" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-56" value="Это юридически значимые данные. Подмена реквизитов или условий ведёт к прямым финансовым потерям, недействительности сделки и судебным спорам." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="320" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-57" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-55" target="v-56"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-58" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="940" y="446" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-59" value="Без данных нельзя подтвердить этапы сделки и обязательства перед дольщиками (214-ФЗ). Восстанавливать их через госорганы долго, а сделки за это время срываются." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="436" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-60" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-58" target="v-59"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-61" value="Данные сделок: договоры ДДУ и купли-продажи, суммы, ипотека, статусы регистрации в СМЭВ (client-mart-app, client-mart-db)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="368" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-62" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-61" target="v-55"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-63" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-61" target="v-58"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-64" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="940" y="562" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-65" value="Ошибки или подмены в учёте приводят к налоговым санкциям, искажённой отчётности и позволяют скрыть мошенничество." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="552" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-66" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-64" target="v-65"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-67" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="940" y="678" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-68" value="Первичку обязательно хранить по 402-ФЗ. Восстановление из резервных копий есть, но процедура не протестирована." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="668" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-69" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-67" target="v-68"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-70" value="Финансовые и платёжные данные: проводки бухучёта, платежи ЖКУ, реквизиты контрагентов (accountant-service-1, платёжная система)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="600" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-71" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-70" target="v-64"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-72" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-70" target="v-67"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-73" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="940" y="794" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-74" value="По журналам видно, когда жильцы бывают дома и как перемещаются, — это риск краж и преследования. Видеоизображение лица и госномер в связке с адресом являются ПДн." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="784" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-75" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-73" target="v-74"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-76" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="940" y="910" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-77" value="Ценность журналов событий — в оперативности, они быстро устаревают. Хранить их дольше нужного срока бесполезно и лишь увеличивает риск, отсюда требование ограничить retention." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1220" y="900" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-78" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-76" target="v-77"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-79" value="Данные «Умного дома»: журналы открытия дверей и шлагбаума, видео с домофона, госномера автомобилей" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="832" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-80" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-79" target="v-73"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-81" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-79" target="v-76"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-82" value="&lt;b&gt;Конфиденциальные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="300" y="388" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="e-83" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="center" target="v-82"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-84" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-82" target="v-43"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-85" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-82" target="v-52"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-86" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-82" target="v-61"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-87" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-82" target="v-70"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-88" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v-82" target="v-79"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-89" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="-890" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-90" value="Отчёты раскрывают объёмы продаж, ценовую политику и планы застройки, то есть коммерческую тайну. Сейчас системы обработки данных никак не ограничивают доступ к DWH." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-900" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-91" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-89" target="v-90"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-92" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="-774" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-93" value="У клиента несколько несогласованных точек регистрации, поэтому в DWH по CDC попадают дубли и противоречивые записи. В итоге управленческие решения принимаются по неверным цифрам." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-784" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-94" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-92" target="v-93"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-95" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="-658" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-96" value="В DWH нет Data Governance, каталога данных и владельцев наборов. Аналитики перестают доверять хранилищу, и вложения в DWH и BI теряют ценность." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-668" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-97" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-95" target="v-96"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-98" value="Аналитика и отчётность BI, агрегаты DWH: продажи, воронка, ценовая политика (Greenplum, S3, BI)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-880" y="-794" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-99" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-98" target="v-89"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-100" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-98" target="v-92"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-101" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-98" target="v-95"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-102" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="-542" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-103" value="История работ нужна для гарантийных обязательств и споров с собственниками и жилинспекцией, а из других источников её восстановить трудно." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-552" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-104" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-102" target="v-103"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-105" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="-426" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-106" value="Неверные сроки и статусы работ в приложении вызывают жалобы собственников и претензии надзорных органов. Данные частично приходят от партнёров без контроля." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-436" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-107" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-105" target="v-106"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-108" value="Данные о текущем и капитальном ремонте: план-график, история работ, подрядчики (tenant-core-app)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-880" y="-504" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-109" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-108" target="v-102"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-110" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-108" target="v-105"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-111" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="-310" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-112" value="Знание схемы сети, версий ПО и интеграций (СМЭВ, платёжная система, API УК) упрощает подготовку целевой атаки." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-320" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-113" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-111" target="v-112"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-114" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;незначительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="-1160" y="-194" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-115" value="Документация хранится в нескольких местах (репозитории, wiki) и восстанавливается. Потеря замедлит работу, но не остановит бизнес." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-204" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-116" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-114" target="v-115"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-117" value="Внутренняя документация: архитектура, конфигурации, регламенты, оргструктура, журналы приложений" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-880" y="-272" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-118" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-117" target="v-111"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-119" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-117" target="v-114"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-120" value="&lt;b&gt;Внутренние данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="-520" y="-542" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="e-121" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="center" target="v-120"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-122" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-120" target="v-98"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-123" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-120" target="v-108"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-124" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-120" target="v-117"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-125" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-1160" y="-18" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-126" value="Компрометация секрета открывает доступ сразу ко всем ПДн, платежам и инфраструктуре. Специалист ИБ один и видит не все изменения, поэтому такую утечку могут долго не заметить." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="-28" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-127" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-125" target="v-126"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-128" value="&lt;b&gt;Обесценивание данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="98" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-129" value="Скомпрометированный ключ или пароль становится бесполезным: его приходится срочно ротировать во всех интеграциях, что вызывает простой сервисов." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="88" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-130" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-128" target="v-129"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-131" value="Учётные данные и секреты: хэши паролей (auth-db-1, Keycloak), сервисные учётки AD, API-ключи УК и платёжной системы, Kubernetes Secrets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-880" y="20" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-132" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-131" target="v-125"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-133" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-131" target="v-128"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-134" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-1160" y="214" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-135" value="С украденным ключом ЭП можно подписывать юридически значимые документы от имени компании, а с ключами TLS — проводить MITM-атаки." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="204" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-136" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-134" target="v-135"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-137" value="&lt;b&gt;Потеря данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-1160" y="330" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-138" value="Без ключа шифрования невозможно восстановиться из бэкапов, а без ЭП останавливаются онлайн-сделки." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="320" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-139" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-137" target="v-138"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-140" value="Криптографические ключи и сертификаты: ЭП для СМЭВ и Росреестра, TLS-ключи, ключи шифрования БД и бэкапов" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-880" y="252" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-141" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-140" target="v-134"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-142" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-140" target="v-137"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-143" value="&lt;b&gt;Утечка данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-1160" y="446" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-144" value="Это специальная категория ПДн (ст. 11 152-ФЗ, 572-ФЗ). Биометрию нельзя «сменить», как пароль, а санкции максимальные." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="436" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-145" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-143" target="v-144"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-146" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-1160" y="562" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-147" value="Если подменить шаблон лица, в дом пройдёт посторонний. Это прямая угроза жизни и имуществу жильцов." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="552" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-148" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-146" target="v-147"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-149" value="Биометрические данные: шаблоны и фото лиц для интеллектуального домофона (новый сервис)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-880" y="484" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-150" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-149" target="v-143"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-151" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-149" target="v-146"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-152" value="&lt;b&gt;Искажение данных&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;критический&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-1160" y="678" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-153" value="Добавленный в белый список чужой номер или лицо, как и перехваченный токен замка, позволяет физически проникнуть в дом или квартиру." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="668" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-154" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-152" target="v-153"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-155" value="&lt;b&gt;Некачественные данные&lt;/b&gt;&lt;br&gt;Оценка: &lt;b&gt;значительный&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-1160" y="794" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="v-156" value="Если права бывшего собственника или арендатора не отозваны, у посторонних остаётся доступ. Если права неверны, законного жильца не пустят в дом." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=6;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1700" y="784" width="480" height="100" as="geometry" /></mxCell>
        <mxCell id="e-157" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-155" target="v-156"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-158" value="Права доступа к устройствам: белые списки лиц и госномеров, ключи и токены управления замками квартир и этажей" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-880" y="716" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="e-159" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-158" target="v-152"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-160" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-158" target="v-155"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-161" value="&lt;b&gt;Секретные данные&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontSize=14;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-520" y="388" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="e-162" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="center" target="v-161"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-163" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-161" target="v-131"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-164" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-161" target="v-140"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-165" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-161" target="v-149"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-166" value="" style="edgeStyle=entityRelationEdgeStyle;curved=1;endArrow=classic;html=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="v-161" target="v-158"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v-167" value="&lt;b&gt;Легенда — оценка риска&lt;/b&gt;" style="text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="-110" y="120" width="220" height="30" as="geometry" /></mxCell>
        <mxCell id="v-168" value="критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="-110" y="155" width="220" height="32" as="geometry" /></mxCell>
        <mxCell id="v-169" value="значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="-110" y="195" width="220" height="32" as="geometry" /></mxCell>
        <mxCell id="v-170" value="незначительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="-110" y="235" width="220" height="32" as="geometry" /></mxCell>
